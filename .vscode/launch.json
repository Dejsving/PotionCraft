{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запустить Server (https)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/PotionCraft.Server/PotionCraft.Server.csproj",
            "launchProfile": "https",
            "preLaunchTask": "build (server debug)"
        },
        {
            "name": "Запустить Web (Vite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev -- --host 127.0.0.1",
            "cwd": "${workspaceFolder}/PotionCraft.Web",
            "serverReadyAction": {
                "pattern": "Local: +(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Отладка тестов",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/PotionCraft.Tests/PotionCraft.Tests.csproj",
            "preLaunchTask": "build"
        },
        {
            "name": "Deploy all (ssh)",
            "type": "node-terminal",
            "request": "launch",
            "command": "echo Deploy pipeline finished.",
            "preLaunchTask": "deploy all (ssh)"
        }
    ],
    "compounds": [
        {
            "name": "Server + Web",
            "configurations": [
                "Запустить Server (https)",
                "Запустить Web (Vite)"
            ],
            "stopAll": true
        }
    ]
}
