{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запустить Server (https)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/PotionCraft.Server/PotionCraft.Server.csproj",
            "launchProfile": "https",
            "preLaunchTask": "build"
        },
        {
            "name": "Запустить Client (https)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/PotionCraft.Client/PotionCraft.Client.csproj",
            "launchProfile": "https",
            "preLaunchTask": "build"
        },
        {
            "name": "Отладка тестов",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/PotionCraft.Tests/PotionCraft.Tests.csproj",
            "preLaunchTask": "build"
        },
        {
            "name": "Deploy all (ssh)",
            "type": "node-terminal",
            "request": "launch",
            "command": "echo Deploy pipeline finished.",
            "preLaunchTask": "deploy all (ssh)"
        }
    ],
    "compounds": [
        {
            "name": "Server + Client",
            "configurations": [
                "Запустить Server (https)",
                "Запустить Client (https)"
            ],
            "stopAll": true
        }
    ]
}
