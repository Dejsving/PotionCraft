{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PotionCraft.sln",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/PotionCraft.Tests/PotionCraft.Tests.csproj",
                "--configuration",
                "Debug",
                "--logger",
                "console;verbosity=detailed"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "start client (https)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/PotionCraft.Client/PotionCraft.Client.csproj",
                "--launch-profile",
                "https",
                "--no-build"
            ],
            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Now listening on:",
                    "endsPattern": "Application started\\. Press Ctrl\\+C to shut down\\."
                }
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "start server (https)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/PotionCraft.Server/PotionCraft.Server.csproj",
                "--launch-profile",
                "https",
                "--no-build"
            ],
            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Now listening on:",
                    "endsPattern": "Application started\\. Press Ctrl\\+C to shut down\\."
                }
            },
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
