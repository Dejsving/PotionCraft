{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "stop app processes",
            "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
            "type": "process",
            "args": [
                "-NoProfile",
                "-Command",
                "Stop-Process -Name 'PotionCraft.Server' -Force -ErrorAction SilentlyContinue; exit 0"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "stop server process",
            "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
            "type": "process",
            "args": [
                "-NoProfile",
                "-Command",
                "Stop-Process -Name 'PotionCraft.Server' -Force -ErrorAction SilentlyContinue; exit 0"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "shutdown build server",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build-server",
                "shutdown"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PotionCraft.sln",
                "--configuration",
                "Debug"
            ],
            "dependsOn": [
                "stop app processes",
                "shutdown build server"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "build (server debug)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PotionCraft.sln",
                "--configuration",
                "Debug"
            ],
            "dependsOn": [
                "stop server process",
                "shutdown build server"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/PotionCraft.Tests/PotionCraft.Tests.csproj",
                "--configuration",
                "Debug",
                "--logger",
                "console;verbosity=detailed"
            ],
            "dependsOn": [
                "stop app processes",
                "shutdown build server"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
          "label": "publish server (linux-x64, self-contained)",
          "type": "process",
          "command": "dotnet",
          "args": [
            "publish",
            "${workspaceFolder}/PotionCraft.Server/PotionCraft.Server.csproj",
            "--configuration",
            "Release",
            "--runtime",
            "linux-x64",
            "--self-contained",
            "true",
            "-o",
            "${workspaceFolder}/artifacts/publish/server"
          ],
          "problemMatcher": "$msCompile",
          "presentation": {
            "reveal": "always",
            "panel": "shared"
          }
        },
        {
          "label": "publish all (linux-x64)",
          "dependsOn": [
            "publish server (linux-x64, self-contained)",
            "build web"
          ],
          "dependsOrder": "sequence"
                },
                {
                    "label": "build web",
                    "type": "process",
                    "command": "npm",
                    "args": [
                        "run",
                        "build"
                    ],
                    "options": {
                        "cwd": "${workspaceFolder}/PotionCraft.Web"
                    },
                    "problemMatcher": [],
                    "group": "build",
                    "presentation": {
                        "reveal": "always",
                        "panel": "shared"
                    }
                },
                {
                    "label": "test web",
                    "type": "process",
                    "command": "npm",
                    "args": [
                        "run",
                        "test"
                    ],
                    "options": {
                        "cwd": "${workspaceFolder}/PotionCraft.Web"
                    },
                    "problemMatcher": [],
                    "presentation": {
                        "reveal": "always",
                        "panel": "shared"
                    }
                },
                {
                    "label": "deploy server (ssh)",
                    "type": "process",
                    "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-File",
                        "${workspaceFolder}/deploy/ps-scripts/deploy-server.ps1"
                    ],
                    "presentation": {
                        "reveal": "always",
                        "panel": "shared"
                    }
                },
                {
                    "label": "deploy web (ssh)",
                    "type": "process",
                    "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-File",
                        "${workspaceFolder}/deploy/ps-scripts/deploy-web.ps1"
                    ],
                    "presentation": {
                        "reveal": "always",
                        "panel": "shared"
                    }
                },
                {
                    "label": "deploy all (ssh)",
                    "dependsOn": [
                        "deploy server (ssh)",
                        "deploy web (ssh)"
                    ],
                    "dependsOrder": "sequence"
        }
    ]
}
